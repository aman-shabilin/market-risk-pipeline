{
  "name": "market_risk_daily_pipeline",
  "description": "Daily market risk pipeline: ingest → quality check → compute metrics",
  "tags": {
    "team": "data-engineering",
    "domain": "market-risk",
    "env": "production"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 18 ? * MON-FRI",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "email_notifications": {
    "on_failure": ["amanbilin13@gmail.com"],
    "on_success": [],
    "no_alert_for_skipped_runs": true
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "ingest_market_data",
      "description": "Ingest OHLCV data from Yahoo Finance into Delta Lake",
      "notebook_task": {
        "notebook_path": "/Repos/Market Data Analysis/market-risk-pipeline/databricks/notebooks/01_ingest_market_data",
        "base_parameters": {
          "catalog": "market_risk",
          "schema": "analytics",
          "source": "yahoo",
          "ticker_source": "table",
          "lookback_days": "30",
          "fetch_chunk_size": "25"
        },
        "source": "WORKSPACE"
      },
      "environment_key": "pipeline_env",
      "timeout_seconds": 3600,
      "retry_on_timeout": false,
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "data_quality_checks",
      "description": "Run quality checks on ingested data",
      "depends_on": [
        {"task_key": "ingest_market_data"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/Market Data Analysis/market-risk-pipeline/databricks/notebooks/03_data_quality_checks",
        "base_parameters": {
          "catalog": "market_risk",
          "schema": "analytics",
          "freshness_threshold_hours": "26",
          "completeness_lookback_days": "30"
        },
        "source": "WORKSPACE"
      },
      "environment_key": "pipeline_env",
      "timeout_seconds": 1800,
      "max_retries": 1
    },
    {
      "task_key": "compute_risk_metrics",
      "description": "Compute risk metrics for all eligible tickers",
      "depends_on": [
        {"task_key": "data_quality_checks"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/Market Data Analysis/market-risk-pipeline/databricks/notebooks/02_compute_risk_metrics",
        "base_parameters": {
          "catalog": "market_risk",
          "schema": "analytics",
          "risk_free_rate": "0.02",
          "min_price_points": "30",
          "metrics_window_days": "365"
        },
        "source": "WORKSPACE"
      },
      "environment_key": "pipeline_env",
      "timeout_seconds": 2400,
      "max_retries": 1
    }
  ],
  "environments": [
    {
      "environment_key": "pipeline_env",
      "spec": {
        "client": "2",
        "dependencies": [
          "yfinance"
        ]
      }
    }
  ],
  "queue": {
    "enabled": true
  }
}
