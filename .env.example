MR_DATABASE_URL=sqlite:///./market_risk.db

# Data source: "local", "s3", or "yahoo"
MR_DATA_SOURCE=local

# Local file source
MR_LOCAL_DATA_PATH=./data/sample

# S3 source
MR_S3_BUCKET=my-market-data-bucket
MR_S3_PREFIX=market-data/
MR_AWS_REGION=us-east-1

# Yahoo Finance source
MR_YAHOO_TICKERS=AAPL,MSFT,GOOGL
MR_YAHOO_PERIOD_DAYS=365

# Redis cache (leave empty to disable)
MR_REDIS_URL=
MR_CACHE_TTL_SECONDS=300

# API server
MR_API_HOST=0.0.0.0
MR_API_PORT=8000
